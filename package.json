{
	"name": "storift",
	"private": true,
	"license": "MIT",
	"version": "0.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"tauri": "tauri",
		"icons": "node scripts/build-icons.mjs",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"test:rules": "firebase emulators:exec --only firestore --project demo-storift \"vitest run --config vitest.rules.config.ts\"",
		"test:e2e": "firebase emulators:exec --only auth,firestore --project demo-storift \"node tests/e2e/coedit.spec.mjs\"",
		"test:e2e:mobile": "node tests/e2e/mobile-header.spec.mjs",
		"test:e2e:preview": "node tests/e2e/preview.spec.mjs",
		"test:e2e:settings": "node tests/e2e/settings.spec.mjs",
		"test:e2e:ai-header": "node tests/e2e/ai-header.spec.mjs",
		"test:e2e:ai-select": "node tests/e2e/ai-select.spec.mjs",
		"test:e2e:user-select": "node tests/e2e/user-select.spec.mjs",
		"test:e2e:scrollbar": "node tests/e2e/scrollbar.spec.mjs",
		"test:e2e:progress": "node tests/e2e/progress.spec.mjs",
		"test:e2e:plot": "node tests/e2e/plot.spec.mjs",
		"test:e2e:characters": "node tests/e2e/characters.spec.mjs",
		"test:e2e:worldbuilding": "node tests/e2e/worldbuilding.spec.mjs",
		"test:e2e:toolbar": "node tests/e2e/toolbar-ext.spec.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tauri-apps/cli": "^2",
		"@testing-library/svelte": "^5.2.8",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^22",
		"@types/uuid": "^11.0.0",
		"@vitest/coverage-v8": "^4.0.6",
		"@vitest/ui": "^4.0.6",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"firebase-tools": "^15.35.0",
		"fake-indexeddb": "^6.2.7",
		"globals": "^16.4.0",
		"happy-dom": "^20.0.10",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vitest": "^4.0.6"
	},
	"dependencies": {
		"@master/css": "2.0.0-rc.69",
		"@master/css-runtime": "2.0.0-rc.69",
		"@master/css.vite": "2.0.0-rc.69",
		"@master/normal.css": "^3.2.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-deep-link": "^2.6.3",
		"@tauri-apps/plugin-http": "^2.8.3",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"@types/marked": "^6.0.0",
		"@xyflow/svelte": "^1.7.0",
		"chart.js": "^4.5.1",
		"date-fns": "^4.1.0",
		"dexie": "^4.2.1",
		"docx": "^9.5.1",
		"dompurify": "^3.3.0",
		"file-saver": "^2.0.5",
		"firebase": "^12.5.0",
		"idb-keyval": "^6.2.2",
		"jspdf": "^3.0.3",
		"jszip": "^3.10.1",
		"mammoth": "^1.11.0",
		"marked": "^16.4.1",
		"uuid": "^13.0.0",
		"yjs": "^13.6.33"
	},
	"packageManager": "bun@1.4.4"
}
